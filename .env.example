# Copy this file to .env before running Docker Compose.
COMPOSE_PROJECT_NAME=irys_store
TZ=UTC
BIND_ADDRESS=127.0.0.1

# Published host ports
FRONTEND_PORT=3000
BACKEND_PORT=8080
POSTGRES_PORT=5432
PGADMIN_PORT=5050

# PostgreSQL application database
POSTGRES_DB=dashboard_db
POSTGRES_USER=dashboard_app
POSTGRES_PASSWORD=kali

# The first start creates or aligns the PostgreSQL schema from the JPA entities.
# After a successful application start, production deployments may use validate.
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
CSV_IMPORT_AUTO_ON_STARTUP=false

# Must be valid Base64 decoding to at least 32 bytes. Generate one with:
# openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -Djava.security.egd=file:/dev/urandom -Duser.timezone=UTC
CORS_ALLOWED_ORIGINS=http://localhost:3000
VITE_API_URL=/api

# Optional pgAdmin profile: docker compose --profile tools up -d pgadmin
PGADMIN_DEFAULT_EMAIL=admin@example.local
PGADMIN_DEFAULT_PASSWORD=
